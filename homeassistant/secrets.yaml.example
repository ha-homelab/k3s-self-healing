# Copy selected entries into the installation's private secrets.yaml.
# Phone MODEL names and GitHub attribution are public; recipients and tokens are not.
ha_core_updater_approve_url: http://ha-core-updater.homeassistant.svc.cluster.local:8099/approve
ha_core_updater_authorization: "Bearer REPLACE_WITH_YOUR_PRIVATE_APPROVAL_TOKEN"
# An absent provider is skipped; persistent HA notifications still work.
optional_phone_notify_service: notify.not_configured
