{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ]
  }
}
